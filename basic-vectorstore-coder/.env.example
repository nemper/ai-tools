# Required for OpenAI embeddings and chat completions.
OPENAI_API_KEY=

# Required for the Pinecone v3 client.
PINECONE_API_KEY=

# Required by this archived app's configuration checks.
PINECONE_API_ENV=

# Optional: enables LangSmith tracing when set.
LANGCHAIN_API_KEY=

# Optional: set to Streamlit to use the Positive login wrapper.
DEPLOYMENT_ENVIRONMENT=
