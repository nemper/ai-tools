# Copy to `.env` (or export in your shell) and fill in. Never commit the real .env.

# OpenAI — used by step3.py to create embeddings (text-embedding-3-large)
OPENAI_API_KEY=

# Pinecone — used by step3.py (upsert) and export_sorted.py (query)
PINECONE_API_KEY=
# Full index host, e.g. https://my-index-abcd123.svc.us-east1-gcp.pinecone.io
PINECONE_HOST=
# Namespace read by export_sorted.py
NAMESPACE=

# NOTE: Google Drive access is NOT via env vars — step1.py loads a service-account
# JSON key file named by CREDENTIALS_FILE (default 'denty.json'). Keep it out of git.
